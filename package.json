{
  "name": "souvenirs-de-couronne",
  "version": "1.0.0",
  "description": "Souvenirs de Couronne - Strategie Medievale",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.souvenirsdecouronne.game",
    "productName": "Souvenirs de Couronne",
    "files": [
      "index.html",
      "main.js",
      "js/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
